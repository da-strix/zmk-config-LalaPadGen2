#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q      &kp L      &kp E         &kp COMMA  &kp PERIOD                                 &kp F      &kp W     &kp R        &kp Y      &kp P
&kp U      &kp I      &kp O         &kp A      &kp MINUS                                  &kp K      &kp S     &kp T        &kp N      &kp H
&kp Z      &kp X      &kp C         &kp V      &kp SLASH                                  &kp G      &kp J     &kp D        &kp M      &kp B
&kp LCTRL  &kp LWIN   &kp LEFT_ALT  &mo 1      &kp SPACE   &kp LEFT_SHIFT  &kp BACKSPACE  &kp ENTER  &mo 2     &kp DELETE   &kp TAB    &kp ESCAPE
           &mkp MB2   &kp RIGHT     &kp DOWN   &kp LEFT    &kp UP          &kp UP         &kp LEFT   &kp DOWN  &kp RIGHT    &mkp MB1
&mkp LCLK  &mkp RCLK  &mkp MCLK                                                                                &mkp LCLK    &mkp RCLK  &mkp MCLK
&mkp MB4   &mkp MB5   &kp LG(TAB)   &kp LG(D)  &kp LCTRL                                  &mkp MB4   &mkp MB5  &kp LG(TAB)  &kp LG(D)  &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp ASTERISK      &kp NUMBER_7       &kp NUMBER_8  &kp NUMBER_9  &kp DOT                    &kp EXCLAMATION   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp AT_SIGN   &kp GRAVE
&kp LS(EQUAL)     &kp NUMBER_4       &kp NUMBER_5  &kp NUMBER_6  &kp MINUS                  &kp HASH          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LS(SEMI)  &kp LS(SINGLE_QUOTE)
&kp NUMBER_0      &kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3  &kp SLASH                  &kp AMPERSAND     &kp CARET             &kp PERCENT            &kp DOLLAR    &kp BACKSLASH
&trans            &trans             &trans        &trans        &trans     &trans  &trans  &trans            &trans                &trans                 &trans        &trans
                  &trans             &trans        &trans        &trans     &trans  &trans  &trans            &trans                &trans                 &trans
&trans            &trans             &trans                                                                                         &trans                 &trans        &trans
&kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans        &trans        &trans                     &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))     &trans                 &trans        &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp F12  &kp F7  &kp F8  &kp F9  &kp F15                  &kp HOME      &kp PAGE_UP     &kp PRINTSCREEN  &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC
&kp F11  &kp F4  &kp F5  &kp F6  &kp F14                  &kp END       &kp PAGE_DOWN   &kp C_PREVIOUS   &kp C_PLAY_PAUSE   &kp C_NEXT
&kp F10  &kp F1  &kp F2  &kp F3  &kp F13                  &kp CAPSLOCK  &kp SCROLLLOCK  &kp C_MUTE       &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC
&trans   &trans  &trans  &trans  &trans   &trans  &trans  &trans        &trans          &trans           &trans             &trans
         &trans  &trans  &trans  &trans   &trans  &trans  &trans        &trans          &trans           &trans
&trans   &trans  &trans                                                                 &trans           &trans             &trans
&trans   &trans  &trans  &trans  &trans                   &trans        &trans          &trans           &trans             &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp PAGE_UP             &kp LC(LS(TAB))  &kp UP_ARROW        &kp LC(TAB)      &kp HOME                                 &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp LG(LC(LEFT_ARROW))  &kp LEFT_ARROW   &kp DOWN_ARROW      &kp RIGHT_ARROW  &kp LG(LC(RIGHT_ARROW))                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&kp PAGE_DOWN           &mkp MB4         &kp LC(LS(ESCAPE))  &mkp MB5         &kp END                                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans                  &trans           &trans              &trans           &trans                   &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
                        &trans           &trans              &trans           &trans                   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans                  &trans           &trans                                                                                                                                      &trans                         &trans                         &trans
&trans                  &trans           &trans              &trans           &trans                                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
